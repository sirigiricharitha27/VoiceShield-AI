# Copy this file to .env and fill in credentials locally. Never commit .env.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_PATH=voiceshield.db
UPLOAD_FOLDER=uploads
FRONTEND_ORIGIN=http://localhost:5173
DEMO_MODE=false
MAX_UPLOAD_MB=12

# Groq fraud-analysis API
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gnani Prisma speech-to-text API (use the endpoint shown in your Gnani console)
GNANI_API_KEY=
GNANI_PRISMA_URL=

# Optional provider endpoints; not fully integrated in this project version
GNANI_EVON_URL=
GNANI_TIMBRE_URL=
